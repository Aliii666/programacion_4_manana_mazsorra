while True:
    print("╔══════════════════════════════╗")
    print("║        CALCULADORA          ║")
    print("╚══════════════════════════════╝")
    print("┌─────────────────────────────┐")
    print("│ 1. Suma                     │")
    print("│ 2. Resta                    │")
    print("│ 3. Multiplicación           │")
    print("│ 4. División                 │")
    print("│ 5. Potencia al cuadrado     │")
    print("│ 6. Raíz cuadrada            │")
    print("│ 7. Simplificar fracción     │")
    print("│ 8. Salir                    │")
    print("└─────────────────────────────┘")
    opcion = input("Seleccione una opción: ")
    if opcion == "1":
        print("═══════ SUMA ═══════")
        a = float(input("Ingrese un número: "))
        b = float(input("Ingrese otro número: "))
        print("► Resultado:", a + b)
    elif opcion == "2":
        print("═══════ RESTA ═══════")
        a = float(input("Ingrese un número: "))
        b = float(input("Ingrese otro número: "))
        print("► Resultado:", a - b)
    elif opcion == "3":
        print("════ MULTIPLICACIÓN ════")
        a = float(input("Ingrese un número: "))
        b = float(input("Ingrese otro número: "))
        print("► Resultado:", a * b)
    elif opcion == "4":
        print("══════ DIVISIÓN ══════")
        a = float(input("Ingrese un número: "))
        b = float(input("Ingrese otro número: "))
        if b != 0:
            print("► Resultado:", a / b)
        else:
            print("✘ No se puede dividir entre cero")
    elif opcion == "5":
        print("════ POTENCIA² ════")
        a = float(input("Ingrese un número: "))
        print("► Resultado:", a * a)
    elif opcion == "6":
        print("════ RAÍZ CUADRADA ════")
        a = float(input("Ingrese un número: "))
        if a >= 0:
            print("► Resultado:", a ** 0.5)
        else:
            print("✘ No existe raíz real")
    elif opcion == "7":
        print("═══ SIMPLIFICAR FRACCIÓN ═══")
        numerador = int(input("Ingrese el numerador: "))
        denominador = int(input("Ingrese el denominador: "))
        if denominador != 0:
            divisor = 1
            for i in range(1, min(abs(numerador), abs(denominador)) + 1):
                if numerador % i == 0 and denominador % i == 0:
                    divisor = i
            print("► Fracción simplificada:")
            print(numerador // divisor, "/", denominador // divisor)
        else:
            print("✘ El denominador no puede ser cero")
    elif opcion == "8":
        print("╔══════════════════════════╗")
        print("║  GRACIAS POR UTILIZARLA  ║")
        print("╚══════════════════════════╝")
        break
    else:
        print("✘ Opción incorrecta")
    print("────────────────────────────")
